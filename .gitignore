# ── Dependencies ────────────────────────────
node_modules/
.npm
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Environment variables ───────────────────
# Real secrets never get committed; .env.example files do.
.env
.env.*
!.env.example

# ── Build output ────────────────────────────
dist/
dist-ssr/
build/
.output/

# ── Caches ──────────────────────────────────
.vite/
vite.config.*.timestamp-*
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ── Logs & runtime data ─────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.pid.lock

# ── Test coverage ───────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Editors & OS ────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db

# ── Local-only files ────────────────────────
*.local
*.tgz
