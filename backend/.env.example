# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/sports

# Port & Host
# The deployment platform normally provides PORT automatically.
PORT=8000
HOST=0.0.0.0

# Comma-separated browser origins allowed to call the API.
# Do not include a trailing slash.
CORS_ORIGIN=http://localhost:5173

# Base URL the seed script sends requests to
API_URL=http://localhost:8000

# Set to true to enable the frontend "Run Seed Matches" button.
SEED_ENABLED=false

# Seed script options
DELAY_MS=250
SEED_MATCH_DURATION_MINUTES=120
# 1 = shift seeded matches so they are live right now
SEED_FORCE_LIVE=1
