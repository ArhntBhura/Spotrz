# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/sports

# Port & Host
PORT=8000
HOST=0.0.0.0

# Base URL the seed script sends requests to
API_URL=http://localhost:8000

# Seed script options
DELAY_MS=250
SEED_MATCH_DURATION_MINUTES=120
# 1 = shift seeded matches so they are live right now
SEED_FORCE_LIVE=1
